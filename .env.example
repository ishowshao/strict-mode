# StrictMode Configuration
# Copy this file to .env and fill in your actual values

# Timezone Settings
STRICTMODE_TZ_LOCAL=Asia/Singapore
STRICTMODE_TZ_MARKET=America/New_York

# Data Source Configuration
STRICTMODE_DATA_SOURCE=yfinance
STRICTMODE_DATA_API_KEY=your-alphavantage-api-key-here

# ATR (Average True Range) Parameters
STRICTMODE_ATR_N=22
STRICTMODE_ATR_K=3.0
STRICTMODE_INITIAL_STOP_PCT=0.05          # Initial stop set 5% below entry price

# Interactive Brokers Configuration
STRICTMODE_IB_HOST=127.0.0.1
STRICTMODE_IB_PORT=7497                    # paper trading default port (7497 for paper, 7496 for live)
STRICTMODE_IB_CLIENT_ID=1

# Telegram Notification Configuration
STRICTMODE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
STRICTMODE_TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Trading Behavior
STRICTMODE_AUTO_LIQUIDATE=false            # Auto-liquidate positions when stop loss is triggered
STRICTMODE_RTH_ONLY=true                   # Regular trading hours only
